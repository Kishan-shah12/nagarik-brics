# ==============================================================================
# NagarikBRICS — Repository .gitignore
# ==============================================================================
# CRITICAL: Final repo must stay under 4 MB. This file is the first line of
# defense. Every entry here exists because that file type has no business
# being version-controlled.
# ==============================================================================

# ==============================================================================
# JAVA
# ==============================================================================

# Compiled bytecode
*.class
*.jar
*.war
*.ear
*.nar

# Build output directories
target/
build/
out/
bin/

# Maven wrapper binaries (bloat — CI downloads Maven itself)
.mvn/wrapper/maven-wrapper.jar
mvnw
mvnw.cmd

# Gradle wrapper binaries (bloat — CI downloads Gradle itself)
gradle/wrapper/gradle-wrapper.jar
gradlew
gradlew.bat

# Gradle build cache
.gradle/

# Maven local repo cache
.m2/

# Dependency reduced POM
dependency-reduced-pom.xml

# ==============================================================================
# PYTHON
# ==============================================================================

# Bytecode cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Distribution / packaging
*.egg-info/
*.egg
dist/
eggs/
*.whl

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# mypy
.mypy_cache/

# Jupyter
.ipynb_checkpoints/

# ==============================================================================
# JAVASCRIPT / NODE
# ==============================================================================

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
package-lock.json

# ==============================================================================
# DOCKER
# ==============================================================================

# Never commit Docker image layers
*.tar
*.tar.gz

# ==============================================================================
# IDE & EDITORS
# ==============================================================================

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# Eclipse
.classpath
.project
.settings/

# VS Code
.vscode/
*.code-workspace

# NetBeans
nbproject/
nbbuild/
nbdist/

# ==============================================================================
# OS GENERATED FILES
# ==============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.nfs*

# ==============================================================================
# ENVIRONMENT & SECRETS
# ==============================================================================

.env
.env.local
.env.*.local
*.pem
*.key
*.p12
*.jks

# ==============================================================================
# LOGS & TEMP
# ==============================================================================

*.log
logs/
tmp/
temp/
*.swp
*.swo
*.bak
*.orig
